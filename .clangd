CompileFlags:
  CompilationDatabase: build/debug  # For compile_commands.json
  Remove:
    - -fno-link-libatomic
    - -fzero-init-padding-bits=all
  Add:
    - --sysroot=C:/CI-Tools/msys64/mingw64/
    - "--target=x86_64-pc-windows-gnu"
    - "-Ibuild/debug/include"
    - -Wno-pragma-pack
    - -ferror-limit=0
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
